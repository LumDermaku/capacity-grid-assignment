{
  "name": "capacity-api",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "dev": "NODE_ENV=development bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir=dist --target=bun --minify --bytecode --env=disable",
    "start": "bun dist/index.js",
    "i:prod": "bun install --production --frozen-lockfile",
    "test": "bun test",
    "codegen": "graphql-codegen --config codegen.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@graphql-tools/load-files": "^7.0.1",
    "@graphql-tools/merge": "^9.2.6",
    "@graphql-tools/schema": "^10.1.3",
    "graphql": "^16.13.0",
    "graphql-yoga": "^5.24.2",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.5",
    "@graphql-codegen/typed-document-node": "^7.1.1",
    "@graphql-codegen/typescript": "^6.1.1",
    "@graphql-codegen/typescript-operations": "^6.1.10",
    "@graphql-codegen/typescript-resolvers": "^6.1.1",
    "@types/bun": "^1.4.2",
    "typescript": "^6.0.2"
  }
}
